[Unit]
Description=C3U Core mainnet node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=c3u
Group=c3u
ExecStart=/usr/local/bin/c3u node --network mainnet --data /var/lib/c3u --listen :39333
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/c3u
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
